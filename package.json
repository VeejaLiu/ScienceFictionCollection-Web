{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=24.22.0 <25",
    "pnpm": "9.15.2"
  },
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs --install",
    "check:runtime": "node scripts/check-runtime.mjs",
    "dev": "node scripts/check-runtime.mjs && node scripts/prepare-collection.mjs && next dev --port 3014",
    "build": "node scripts/check-runtime.mjs && node scripts/prepare-collection.mjs && node scripts/generate-third-party-notices.mjs && next build && node scripts/finalize-export.mjs",
    "build:pages": "node scripts/check-runtime.mjs && node scripts/build-pages.mjs",
    "metadata:prepare": "node scripts/check-runtime.mjs && node scripts/prepare-collection.mjs",
    "check:export": "node scripts/check-runtime.mjs && node scripts/verify-static-export.mjs",
    "start": "node scripts/check-runtime.mjs && node scripts/serve-static.mjs",
    "lint": "eslint .",
    "test": "node scripts/check-runtime.mjs && node --test tests/*.test.mjs",
    "typecheck": "node scripts/check-runtime.mjs && next typegen && tsc --noEmit --incremental false",
    "assets:icons": "node scripts/check-runtime.mjs && node scripts/generate-icons.mjs",
    "licenses:generate": "node scripts/check-runtime.mjs && node scripts/generate-third-party-notices.mjs",
    "docs:generate": "node scripts/check-runtime.mjs && node scripts/generate-readme.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.6.0",
    "epubjs": "0.3.93",
    "input-otp": "1.4.2",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-day-picker": "9.13.2",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.54.1",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "overrides": {
      "epubjs>@xmldom/xmldom": "^0.8.11",
      "epubjs>@types/localforage": "-",
      "epubjs>path-webpack": "npm:path-browserify@1.0.1"
    }
  }
}
