# Defaults to ../ScienceFictionCollection/metadata relative to this Web project.
# Only JSON metadata and referenced images are read; novel bodies are not needed.
# COLLECTION_METADATA_DIR=/absolute/path/to/ScienceFictionCollection/metadata

# Planned GitHub Pages project URL. Use your actual URL if configuring another host.
SITE_URL=https://veejaliu.github.io/ScienceFictionCollection-Web/

# Leave empty for local development. pnpm build:pages sets the project base path.
NEXT_PUBLIC_BASE_PATH=
